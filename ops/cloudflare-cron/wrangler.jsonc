{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "pti093-sync-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["0 1 * * *", "20 1 * * *", "30 5 * * *"]
  }
}
